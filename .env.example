# Every setting Strata reads. No values here: copy to apps/web/.env.local for local runs.

# The web app and API
PORT=
MONGODB_URI=
# A service token: full access to every scope (tests, the OpenCode sandbox, scripts). People use API keys made on /connect.
MEMORY_API_TOKEN=
# Signs session cookies. At least 32 random characters.
BETTER_AUTH_SECRET=
# The app's public address, e.g. http://localhost:9316
BETTER_AUTH_URL=
# stub (default) | openai | anthropic. Real providers read their own key names, which stay in your environment.
MEMORY_AI_PROVIDER=

# The clients (Claude Code plugin, OpenCode plugin)
MEMORY_API_URL=
# MEMORY_API_TOKEN above, or an API key made on /connect
