# Every setting Strata reads. No values here: copy to apps/web/.env.local for local runs.

# The web app and API
PORT=
MONGODB_URI=
# A service token: full access to every scope (tests, the OpenCode sandbox, scripts). People use API keys made on /connect.
MEMORY_API_TOKEN=
# Signs session cookies. At least 32 random characters.
BETTER_AUTH_SECRET=
# The app's public address, e.g. http://localhost:9316
BETTER_AUTH_URL=
# Embeddings: stub (default; deterministic hash vectors, offline, NOT semantic) | voyage (Voyage AI, recommended) |
# openai. Changing provider, model or dimensions: run `pnpm db:indexes`, then `pnpm --filter @strata/web db:reembed`.
# See docs/atlas.md.
MEMORY_AI_PROVIDER=
# Optional. voyage: voyage-3.5 at 1024 by default; openai: text-embedding-3-small at 1536.
MEMORY_EMBED_MODEL=
MEMORY_EMBED_DIMENSIONS=
# Optional, ms per embeddings request for stored memories (default 15000; a recall query gets at most 3000).
MEMORY_EMBED_TIMEOUT_MS=
# The key for the provider you chose. Never commit a value.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Email, through Amazon SES: all four, or email is off. sst.config.ts makes the send-only key and says how to fetch
# these lines. Check them with pnpm mail:test <email>.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# e.g. "Strata <no-reply@strata.anythingfactory.dev>"
MAIL_FROM=

# Product history (/products/<id>/history): local clones whose git history a product's page may show, as JSON from the
# repository's name (as the product lists it) to an absolute path, e.g. {"github.com/acme/app":"/srv/clones/app"}.
# Nothing else on disk is read. Unset: no product shows history.
STRATA_LOCAL_REPOS=

# The Claude Code plugin (clients/claude-code)
# Optional overrides; settings and sign-in normally live in /strata:dashboard.
STRATA_URL=
STRATA_HOME=
