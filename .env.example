# Every setting Strata reads. No values here: copy to apps/web/.env.local for local runs.

# The web app and API
PORT=
MONGODB_URI=
# A service token: full access to every scope (tests, the OpenCode sandbox, scripts). People use API keys made on /connect.
MEMORY_API_TOKEN=
# Signs session cookies. At least 32 random characters.
BETTER_AUTH_SECRET=
# The app's public address, e.g. http://localhost:9316
BETTER_AUTH_URL=
# stub (default) | openai | anthropic. Real providers read their own key names, which stay in your environment.
MEMORY_AI_PROVIDER=

# Email, through Amazon SES: all four, or email is off. sst.config.ts makes the send-only key and says how to fetch
# these lines. Check them with pnpm mail:test <email>.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# e.g. "Strata <no-reply@strata.anythingfactory.dev>"
MAIL_FROM=

# The Claude Code plugin (clients/claude-code)
# Optional overrides; settings and sign-in normally live in /strata:dashboard.
STRATA_URL=
STRATA_HOME=
