{
  "name": "strata",
  "private": true,
  "description": "Strata: capture coding-agent sessions, remember what matters, and give it back without breaking the prompt cache.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @strata/web run dev",
    "build": "pnpm --filter @strata/claude-code run build && pnpm --filter @strata/web run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:db": "pnpm --filter @strata/web run test:db",
    "test:acceptance": "pnpm --filter @strata/claude-code run test:acceptance",
    "db:indexes": "pnpm --filter @strata/web run db:indexes",
    "db:seed": "pnpm --filter @strata/web run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
