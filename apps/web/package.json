{
  "name": "@strata/web",
  "version": "0.1.0",
  "private": true,
  "description": "The Strata web app: the API every client talks to, the only thing that touches MongoDB, and the place people see and govern what's remembered.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-9316}",
    "build": "next build",
    "start": "next start --port ${PORT:-9316}",
    "typecheck": "next typegen && tsc -p .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:indexes": "node scripts/db-indexes.ts",
    "db:seed": "node scripts/db-seed.ts",
    "invite": "node scripts/invite.ts",
    "hub:backfill": "node scripts/hub-backfill.ts"
  },
  "dependencies": {
    "@strata/contracts": "workspace:*",
    "@better-auth/mongo-adapter": "1.7.23",
    "better-auth": "1.7.23",
    "lucide-react": "1.73.0",
    "mongodb": "7.9.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
